#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

reorder rootPrims = ["Root", "GridMaterial"]

def Xform "Root"
{
    reorder nameChildren = ["Wall", "Slot", "playerMaterials", "Player", "Box"]
    def "Wall" (
        references = @Wall.usda@
    )
    {
        reorder nameChildren = ["smokeParticleEmitter", "wallMesh", "wallMaterials", "SmokeParticleEmitter"]
        float3 xformOp:scale = (0.562, 0.562, 0.562)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Wall"
        {
            over "Wall"
            {
                float3 xformOp:scale = (0.75, 0.75, 0.75)
            }
        }

        over "wallMesh"
        {
            float3 xformOp:scale = (1, 1, 1)
        }

        over "SmokeParticleEmitter"
        {
            float3 xformOp:scale = (1, 1, 1)
        }
    }

    def Xform "Player"
    {
        reorder nameChildren = ["playerAnimations", "idleAnimation", "pushingAnimation", "walkingAnimation", "AnimationLibrary", "puzzleSolvedAnimation", "stuckAnimation", "playerAudio"]
        float3 xformOp:scale = (0.75, 0.75, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def "playerAnimations" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
            references = @Assets/Player/Player.usdz@
        )
        {
            reorder nameChildren = ["undoAudio", "Materials", "Robbie_03", "AnimationLibrary", "ParticleEmitterFireworks", "puzzleAudio", "stuckAudio", "puzzleSolvedAudio", "playerWalkAudio", "playerMaterial", "arrivalAudio"]
            rel material:binding = None (
                bindMaterialAs = "weakerThanDescendants"
            )
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.0007, 0.0007, 0.0007)
            float3 xformOp:translate = (0, -0.0475, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def RealityKitComponent "AnimationLibrary"
            {
                token info:id = "RealityKit.AnimationLibrary"

                def RealityKitAnimationFile "puzzleSolvedAnimation"
                {
                    uniform asset file = @Assets/Player/Animations/puzzleSolvedAnimation.usdz@
                    uniform string name = "puzzleSolvedAnimation"
                }

                def RealityKitAnimationFile "walkingAnimation"
                {
                    uniform asset file = @Assets/Player/Animations/walkingAnimation.usdz@
                    uniform string name = "walkingAnimation"
                }

                def RealityKitAnimationFile "pushingAnimation"
                {
                    uniform asset file = @Assets/Player/Animations/pushingAnimation.usdz@
                    uniform string name = "pushingAnimation"
                }

                def RealityKitAnimationFile "stuckAnimation"
                {
                    uniform asset file = @Assets/Player/Animations/stuckAnimation.usdz@
                    uniform string name = "stuckAnimation"
                }

                def RealityKitAnimationFile "idleAnimation"
                {
                    uniform asset file = @Assets/Player/Animations/idleAnimation.usdz@
                    uniform string name = "idleAnimation"
                }
            }

            def Xform "ParticleEmitterFireworks"
            {
                quatf xformOp:orient = (0.99999994, 0, 0, 0)
                float3 xformOp:scale = (1428.5715, 1428.5715, 1428.5715)
                float3 xformOp:translate = (0, 67.85715, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def RealityKitComponent "VFXEmitter"
                {
                    token info:id = "RealityKit.VFXEmitter"

                    def RealityKitStruct "currentState"
                    {
                        token birthDirection = "Normal"
                        token birthLocation = "Surface"
                        float3 emissionDirection = (0, 1, 0)
                        double emissionDuration = 1
                        double emissionDurationVariation = 0
                        token emitterShape = "Plane"
                        double idleDuration = 0
                        double idleDurationVariation = 0
                        bool isLocal = 0
                        bool isSpawningEnabled = 1
                        bool loops = 1
                        float particleSpeed = 1
                        float3 shapeSize = (0.05, 1, 0.05)
                        bool spawnInheritParentColor = 1
                        token spawnOccasion = "OnDeath"
                        float spawnSpreadFactor = 0.2
                        float spawnSpreadFactorVariation = 0.1
                        float spawnVelocityFactor = 0.1
                        double warmupDuration = 0

                        def RealityKitStruct "mainEmitter"
                        {
                            float3 acceleration = (0, -0.1, 0)
                            token animationRepeatMode = "Looping"
                            token billboardMode = "Billboard"
                            float birthRate = 5
                            float birthRateVariation = 1
                            token blendMode = "Additive"
                            float colorEvolutionPower = 1
                            int64 columnCount = 2
                            float dampingFactor = 3.2
                            float4 endColorA = (0.0013309671, 0.03458923, 1, 1)
                            float4 endColorB = (0.11386989, 0.0064959256, 0.10626237, 1)
                            float frameRate = 0
                            float frameRateVariation = 0
                            int64 initialFrame = 0
                            int64 initialFrameVariation = 3
                            bool isAnimated = 1
                            bool isLightingEnabled = 0
                            float noiseAnimationSpeed = 0
                            float noiseScale = 1
                            float noiseStrength = 0
                            token opacityOverLife = "Constant"
                            float particleAngle = 0
                            float particleAngleVariation = 0
                            float particleAngularVelocity = 0
                            float particleAngularVelocityVariation = 0
                            asset particleImage = @ParticleEmitterPresetTextures/flaresheet.exr@
                            double particleLifeSpan = 0.52
                            double particleLifeSpanVariation = 0
                            float particleMass = 1
                            float particleMassVariation = 0
                            float particleSize = 0.01
                            float3 radialGravityCenter = (0, 12, 0)
                            float radialGravityStrength = -1
                            int64 rowCount = 2
                            float sizeMultiplierAtEndOfLifespan = 1
                            float sizeMultiplierAtEndOfLifespanPower = 1
                            token sortOrder = "IncreasingDepth"
                            float spreadingAngle = 0.1
                            float4 startColorA = (1, 0.051991113, 1, 1)
                            float4 startColorB = (0, 0.98059916, 1, 1)
                            float stretchFactor = 0
                            bool useEndColor = 0
                            bool useEndColorRange = 0
                            bool useStartColorRange = 1
                            float3 vortexDirection = (0, 1, 0)
                            float vortexStrength = 0
                        }

                        def RealityKitStruct "spawnedEmitter"
                        {
                            float3 acceleration = (0, -0.15, 0)
                            token animationRepeatMode = "Looping"
                            token billboardMode = "Billboard"
                            float birthRate = 39000
                            float birthRateVariation = 8000
                            token blendMode = "Additive"
                            float colorEvolutionPower = 1
                            int64 columnCount = 2
                            float dampingFactor = 4
                            float4 endColorA = (0.0013309671, 0.03458923, 1, 1)
                            float4 endColorB = (0.11386989, 0.0064959256, 0.10626237, 1)
                            float frameRate = 12
                            float frameRateVariation = 3
                            int64 initialFrame = 0
                            int64 initialFrameVariation = 3
                            bool isAnimated = 1
                            bool isLightingEnabled = 0
                            float noiseAnimationSpeed = 0.2
                            float noiseScale = 3
                            float noiseStrength = 0.02
                            token opacityOverLife = "LinearFadeOut"
                            float particleAngle = 0
                            float particleAngleVariation = 2
                            float particleAngularVelocity = 0
                            float particleAngularVelocityVariation = 0
                            asset particleImage = @ParticleEmitterPresetTextures/flaresheet.exr@
                            double particleLifeSpan = 1.8
                            double particleLifeSpanVariation = 0.5
                            float particleMass = 0.75
                            float particleMassVariation = 0.5
                            float particleSize = 0.03
                            float particleSizeVariation = 0.01
                            float3 radialGravityCenter = (0, -3, -3)
                            float radialGravityStrength = 0
                            int64 rowCount = 2
                            float sizeMultiplierAtEndOfLifespan = 0.01
                            float sizeMultiplierAtEndOfLifespanPower = 0.03
                            token sortOrder = "IncreasingID"
                            float spreadingAngle = 3
                            float4 startColorA = (1, 1, 1, 1)
                            float4 startColorB = (1, 1, 1, 1)
                            float stretchFactor = 0
                            bool useEndColor = 0
                            bool useEndColorRange = 0
                            bool useStartColorRange = 0
                            float3 vortexDirection = (0, 1, 0)
                            float vortexStrength = 0
                        }
                    }
                }
            }

            def Material "playerMaterial" (
                references = </Root/Box/Material>
            )
            {
                token cullMode = "unspecified" (
                    allowedTokens = ["unspecified", "none", "front", "back"]
                )
                asset inputs:BaseTexture = @Assets/Player/Player Textures 1K/Robbie_03_MI_BaseColor.png@ (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (-523.0039, -32.566406)
                        }
                    }
                )
                asset inputs:MetalicTexture = @Assets/Player/Player Textures 1K/Robbie_03_MI_MetallicRoughness.png@ (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (-510.54602, 677.731)
                            int stackingOrderInSubgraph = 255
                        }
                    }
                )
                asset inputs:NormalTexture = @Assets/Player/Player Textures 1K/Robbie_03_MI_Normal.png@ (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (-817.8617, 151.38794)
                        }
                    }
                )
                asset inputs:RoughnessTexture = @Assets/Player/Player Textures 1K/Robbie_03_MI_MetallicRoughness.png@ (
                    customData = {
                        dictionary realitykit = {
                            float2 positionInSubgraph = (-518.08704, 418.43228)
                            int stackingOrderInSubgraph = 255
                        }
                    }
                )
                token outputs:mtlx:surface.connect = </Root/Player/playerAnimations/playerMaterial/PBRSurface.outputs:out>
                token outputs:realitykit:vertex
                token outputs:surface.connect = None
                float2 ui:nodegraph:node:pos = (-213.05585, 382.562)
                int ui:nodegraph:node:stackingOrder = 2
                float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (335.25, 100.5)

                def Shader "PBRSurface" (
                    active = true
                )
                {
                    uniform token info:id = "ND_realitykit_pbr_surfaceshader"
                    float inputs:ambientOcclusion
                    color3f inputs:baseColor.connect = </Root/Player/playerAnimations/playerMaterial/TiledImage.outputs:out>
                    float inputs:clearcoat
                    float3 inputs:clearcoatNormal
                    float inputs:clearcoatRoughness
                    color3f inputs:emissiveColor
                    bool inputs:hasPremultipliedAlpha
                    float inputs:metallic.connect = </Root/Player/playerAnimations/playerMaterial/TiledImage_1.outputs:out>
                    float3 inputs:normal.connect = </Root/Player/playerAnimations/playerMaterial/NormalMapDecode.outputs:out>
                    float inputs:opacity
                    float inputs:opacityThreshold
                    float inputs:roughness.connect = </Root/Player/playerAnimations/playerMaterial/TiledImage_2.outputs:out>
                    float inputs:specular
                    token outputs:out
                    float2 ui:nodegraph:node:pos = (81.48828, 79.109375)
                    int ui:nodegraph:node:stackingOrder = 1
                }

                def Shader "TiledImage"
                {
                    uniform token info:id = "ND_tiledimage_color3"
                    color3f inputs:default
                    asset inputs:file.connect = </Root/Player/playerAnimations/playerMaterial.inputs:BaseTexture>
                    float2 inputs:texcoord
                    color3f outputs:out
                    float2 ui:nodegraph:node:pos = (-247.8164, 23.894531)
                    int ui:nodegraph:node:stackingOrder = 4
                }

                def Shader "UsdPreviewSurface" (
                    active = false
                )
                {
                    uniform token info:id = "UsdPreviewSurface"
                    token outputs:surface
                }

                def Shader "NormalMapDecode"
                {
                    uniform token info:id = "ND_normal_map_decode"
                    float3 inputs:in.connect = </Root/Player/playerAnimations/playerMaterial/Image.outputs:out>
                    float3 outputs:out
                    float2 ui:nodegraph:node:pos = (-238.38748, 221.83734)
                    int ui:nodegraph:node:stackingOrder = 7
                }

                def Shader "Image"
                {
                    uniform token info:id = "ND_image_vector3"
                    float3 inputs:default
                    asset inputs:file.connect = </Root/Player/playerAnimations/playerMaterial.inputs:NormalTexture>
                    float2 inputs:texcoord
                    float3 outputs:out
                    float2 ui:nodegraph:node:pos = (-517.64087, 214.21887)
                    int ui:nodegraph:node:stackingOrder = 10
                }

                def Shader "TiledImage_1"
                {
                    uniform token info:id = "ND_tiledimage_float"
                    float inputs:default
                    asset inputs:file.connect = </Root/Player/playerAnimations/playerMaterial.inputs:MetalicTexture>
                    float2 inputs:texcoord
                    float outputs:out
                    float2 ui:nodegraph:node:pos = (-241.41255, 693.2295)
                    int ui:nodegraph:node:stackingOrder = 254
                }

                def Shader "TiledImage_2"
                {
                    uniform token info:id = "ND_tiledimage_float"
                    float inputs:default
                    asset inputs:file.connect = </Root/Player/playerAnimations/playerMaterial.inputs:RoughnessTexture>
                    string inputs:filtertype
                    float2 inputs:realworldimagesize
                    float2 inputs:realworldtilesize
                    float2 inputs:texcoord
                    float2 inputs:uvoffset
                    float2 inputs:uvtiling
                    float outputs:out
                    float2 ui:nodegraph:node:pos = (-248.95357, 433.9307)
                    int ui:nodegraph:node:stackingOrder = 178
                }
            }

            over "Materials"
            {
                over "Robbie_03_MI"
                {
                    token outputs:mtlx:surface
                    token outputs:realitykit:vertex
                }
            }

            over "Robbie_03"
            {
                over "root"
                {
                    over "Robbie_03_geometry" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = None (
                            bindMaterialAs = "weakerThanDescendants"
                        )

                        over "Robbie_03_MI_subset" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </Root/Player/playerAnimations/playerMaterial> (
                                bindMaterialAs = "weakerThanDescendants"
                            )
                        }
                    }
                }
            }
        }

