#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.60.4)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def RealityKitComponent "AudioLibrary"
    {
        uniform token info:id = "RealityKit.AudioLibrary"

        def RealityKitDict "resources"
        {
            string[] keys = ["playerWalkAudio.wav"]
            rel values = </Root/playerWalkAudio_wav>
        }
    }

    def RealityKitComponent "SpatialAudio"
    {
        uniform token info:id = "RealityKit.SpatialAudio"
        float rolloffFactor = 0.9797794
    }

    def RealityKitAudioFile "playerWalkAudio_wav"
    {
        uniform asset file = @Audio/playerWalkAudio.wav@
        uniform bool shouldLoop = 0
    }
}

