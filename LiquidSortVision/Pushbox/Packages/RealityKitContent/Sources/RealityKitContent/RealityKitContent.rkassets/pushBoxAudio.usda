#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (448.60.4)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["AudioLibrary", "SpatialAudio", "pushBoxAudio_wav"]
    def RealityKitComponent "AudioLibrary"
    {
        uniform token info:id = "RealityKit.AudioLibrary"

        def RealityKitDict "resources"
        {
            string[] keys = ["pushBoxAudio.wav"]
            rel values = </Root/pushBoxAudio_wav>
        }
    }

    def RealityKitComponent "SpatialAudio"
    {
        uniform token info:id = "RealityKit.SpatialAudio"
        float rolloffFactor = 0
    }

    def RealityKitAudioFile "pushBoxAudio_wav"
    {
        uniform asset file = @Audio/pushBoxAudio.wav@
        uniform bool shouldLoop = 0
    }
}

